# Required administrator password
# Local: copy this file to .dev.vars and fill in the value.
# Cloudflare Pages: add ADMIN_PASSWORD as an encrypted Secret.
ADMIN_PASSWORD=

# Optional GitHub repository metadata
# Add GITHUB_TOKEN as an encrypted Secret. Use a read-only token.
# Without it, the admin browser reads public repository information directly from GitHub.
GITHUB_TOKEN=

# Optional administrator login protection
# Add TURNSTILE_SITE_KEY as a plain variable and TURNSTILE_SECRET_KEY as an encrypted Secret.
# Configure both values, redeploy, then enable Turnstile in Admin > Service Settings.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Telegram push
# Add TGTOKEN as an encrypted Secret.
# Configure the recipient, test the connection, and enable Telegram in Admin > Service Settings.
TGTOKEN=

# D1 database binding
# Bind the HTools D1 database with the variable name DB in Cloudflare Pages.
# DB is a binding, not an environment variable, so no DB value is listed here.

{
  "name": "htools",
  "version": "1.0.20",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "db:init:local": "wrangler d1 execute DB --local --config wrangler.local.toml --file db/schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --config wrangler.local.toml --file db/schema.sql"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "postcss": "^8.5.25",
    "typescript": "^5.9.2",
    "vite": "^7.2.7",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
